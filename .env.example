# ─── Clerk ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ─── Allowlist (REQUIRED — empty = nobody gets access) ─────────────────────────
REAGENT_ALLOWED_EMAILS=

# ─── Product URLs ──────────────────────────────────────────────────────────────
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production / staging (set in Vercel):
# NEXT_PUBLIC_APP_URL=https://asquares.app
#
# Product opens at ${NEXT_PUBLIC_APP_URL}/reagent until Clerk satellite is configured.
NEXT_PUBLIC_REAGENT_URL=http://localhost:3000/reagent

# ─── Database (Neon free tier) ─────────────────────────────────────────────────
DATABASE_URL=

# ─── Gemini (Google AI Studio key, usually starts with AIza) ───────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─── Vapi ──────────────────────────────────────────────────────────────────────
# Required in production. Optional locally.
VAPI_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ─── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Keep onboarding@resend.dev until asquares.app is verified in Resend.
REAGENT_ALERT_FROM=REagent <onboarding@resend.dev>
REAGENT_ALERT_TARGET=
