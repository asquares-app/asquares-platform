# ─── Clerk (free Hobby plan) ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ─── Allowlist ─────────────────────────────────────────────────────────────────
# Comma-separated emails allowed to access REagent dashboard.
REAGENT_ALLOWED_EMAILS=

# ─── Product URLs ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used for production subdomain / emails. Local demos open via /reagent on the main host.
NEXT_PUBLIC_REAGENT_URL=https://reagent.asquares.app

# ─── Database (Neon free tier) ─────────────────────────────────────────────────
DATABASE_URL=

# ─── Gemini (Google AI Studio) ─────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional override. Default tries gemini-3.6-flash then fallbacks.
GEMINI_MODEL=gemini-3.6-flash

# ─── Vapi ──────────────────────────────────────────────────────────────────────
# Leave blank for local MVP. Set before public production.
VAPI_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ─── Resend (free tier — 100 emails/day) ───────────────────────────────────────
RESEND_API_KEY=
# Until your domain is verified in Resend, keep the default from address.
REAGENT_ALERT_FROM=REagent <onboarding@resend.dev>
# Dealer inbox that receives lead alerts (must be allowed by Resend free tier).
REAGENT_ALERT_TARGET=
